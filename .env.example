# ─── AI / LLM ────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL_ID=llama-3.3-70b-instant

# ─── Supabase ────────────────────────────────────────────
# Find these in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

SUPABASE_SERVICE_ROLE_KEY=        # Server-only, never expose to browser

# ─── Dodo Payments ───────────────────────────────────────
# Find these in: Dodo Dashboard → Developer → API Keys
DODO_API_KEY=
DODO_WEBHOOK_SECRET=              # From: Dashboard → Webhooks → Secret

# Product IDs — create these in: Dodo Dashboard → Products
NEXT_PUBLIC_DODO_OPERATOR_PRODUCT_ID=     # $7/mo plan
NEXT_PUBLIC_DODO_OPERATOR_ANNUAL_PRODUCT_ID=  # $56/yr plan

# ─── App ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000  # Change to your prod domain

# ─── Optional ────────────────────────────────────────────
# DODO_ENV=live   # Uncomment to switch Dodo from test → live mode

HUGGINGFACE_API_KEY=   # Required for image generation + RAG embeddings

# ─── RAG / Vector Store ─────────────────────────────────────
CHROMA_API_KEY=                          # From: trychroma.com → Dashboard → API Keys
CHROMA_TENANT=                           # From: trychroma.com → your tenant ID
CHROMA_DATABASE=                         # Database name you created in Chroma Cloud